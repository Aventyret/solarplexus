{
	"name": "solarplexus",
	"version": "1.21.0",
	"private": true,
	"description": "",
	"author": "Äventyret",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"block"
	],
	"homepage": "https://aventyret.com",
	"repository": "",
	"main": "build/index.js",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=26"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@prettier/plugin-php": "^0.26.0",
		"@wordpress/scripts": "^37.2.0",
		"eslint": "^9.39.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.0.0",
		"prettier": "^3.10.1",
		"vitepress": "^1.6.4"
	},
	"scripts": {
		"build": "pnpm lint:js && wp-scripts build",
		"format:check": "prettier ./  --check",
		"format": "prettier ./ --write",
		"lint:js": "eslint ./src",
		"lint:php": "./vendor/bin/phplint",
		"lint": "pnpm lint:js && pnpm lint:php",
		"packages-update": "wp-scripts packages-update",
		"start": "wp-scripts start",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:serve": "vitepress serve docs",
		"test": "pnpm format:check && pnpm lint",
		"translate": "pnpm translate:pot && pnpm translate:update",
		"translate:pot": "wp i18n make-pot . ./languages/solarplexus.pot --exclude=node_modules,vendor,src/*.js,tests --include=build/*.js",
		"translate:update": "wp i18n update-po ./languages/solarplexus.pot ./languages",
		"translate:compile": "pnpm translate:mo && pnpm translate:js",
		"translate:js": "wp i18n make-json languages --no-purge",
		"translate:mo": "wp i18n make-mo ./languages ./languages"
	},
	"dependencies": {
		"@wordpress/icons": "^21.0.0"
	}
}
